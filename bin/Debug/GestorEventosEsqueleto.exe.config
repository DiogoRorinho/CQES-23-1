<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="GestorEventosDb" connectionString="Data Source=|DataDirectory|\gestoreventos.db;Version=3;" providerName="System.Data.SQLite"/>
  </connectionStrings>
  <appSettings>
    <add key="PastaPdfs" value="Pdfs"/>
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
</configuration>
